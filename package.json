{
  "name": "cci-posts-carousel",
  "version": "2.1.0",
  "description": "Build and manage reusable WordPress carousels.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "webpack --progress --watch --mode=development",
    "build": "webpack --progress --config webpack.config.js --mode=production",
    "package:wp": "npx -y node@23 scripts/build-wp-release.mjs",
    "i18n": "npm run i18n-pot && npm run i18n-json",
    "i18n-pot": "wp i18n make-pot ./ ./languages/cci-posts-carousel.pot --domain=cci-posts-carousel --exclude=app",
    "i18n-json": "wp i18n make-json ./languages/ --no-purge",
    "format-js": "wp-scripts format-js",
    "prettier": "@wordpress/prettier-config",
    "format": "node scripts/quality/format.mjs",
    "format:check": "node scripts/quality/format.mjs --check"
  },
  "keywords": [],
  "author": "Cool Cat Ideas",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=23.7.0",
    "npm": ">=11.7.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.8",
    "@babel/runtime": "^7.29.7",
    "@cci/admin-ui": "https://github.com/cool-cat-ideas/cci-admin-ui/releases/download/v1.0.1/cci-admin-ui-1.0.1.tgz",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swiper": "^12.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@cci/admin-theme": "https://github.com/cool-cat-ideas/cci-admin-ui/releases/download/v1.0.1/cci-admin-theme-1.0.1.tgz",
    "@wordpress/prettier-config": "^4.48.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "prettier": "3.9.10",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "esbuild": "0.28.2"
  }
}
