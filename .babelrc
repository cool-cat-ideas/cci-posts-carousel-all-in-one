{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "browsers": [
            ">0.5%",
            "last 2 versions",
            "not dead",
            "not ie <= 11"
          ]
        }
      }
    ],
    [
      "@babel/preset-react",
      {
        "runtime": "classic"
      }
    ]
  ],
  "plugins": [
    [
      "@babel/plugin-transform-runtime",
      {
        "helpers": true,
        "regenerator": true
      }
    ]
  ]
}
